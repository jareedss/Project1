    {
      "parameters": {
        "jsCode": "// Compara las visitas/favoritos de hoy con la última fecha anterior de cada listing.\nconst rows = $input.all().map(i => i.json).filter(r => r.key);\nconst today = $now.toFormat('yyyy-MM-dd');\n\nconst byListing = {};\nfor (const r of rows) {\n  (byListing[r.listing_id] ||= []).push(r);\n}\n\nconst out = [];\nfor (const [id, list] of Object.entries(byListing)) {\n  list.sort((a, b) => String(a.date).localeCompare(String(b.date)));\n  const current = list.find(r => r.date === today);\n  if (!current) continue;\n  const previous = [...list].reverse().find(r => r.date < today);\n\n  out.push({\n    json: {\n      listing_id: id,\n      title: current.title,\n      views: Number(current.views),\n      favorites: Number(current.favorites),\n      views_delta: previous ? Number(current.views) - Number(previous.views) : null,\n      favorites_delta: previous ? Number(current.favorites) - Number(previous.favorites) : null,\n      auto_renew: String(current.auto_renew).toUpperCase() === 'TRUE',\n      has_previous: Boolean(previous),\n    },\n  });\n}\nreturn out;"
      },
