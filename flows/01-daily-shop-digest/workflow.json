      "parameters": {
        "jsCode": "// Toma la respuesta de Etsy y devuelve un elemento por listing\n// con solo los campos que vamos a guardar en el histórico.\nconst results = $input.first().json.results || [];\nconst today = $now.toFormat('yyyy-MM-dd');\n\nreturn results.map(listing => ({\n    json: {\n    key: `${today}_${listing.listing_id}`,\n    date: today,\n    listing_id: listing.listing_id,\n    title: listing.title.slice(0, 40),\n    views: listing.views,\n    favorites: listing.num_favorers,\n    price: listing.price.amount / listing.price.divisor,\n    currency: listing.price.currency_code,\n    auto_renew: listing.should_auto_renew,\n  },\n}));"
      },
