      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "const listings = $input.all().map(i => i.json);\n\nconst system = `You are a concise e-commerce analyst for an Etsy shop that sells Google Sheets templates.\nYou receive daily stats per listing (views, favorites, deltas versus the previous recorded day).\nReply ONLY with valid JSON, no markdown, with this shape:\n{\"summary\": string, \"alert\": string or null, \"action\": string}\nRules:\n- Write in Spanish. summary: max 2 sentences. action: one concrete thing to do today.\n- Volumes are tiny. Never draw statistical conclusions from a few views; say so if relevant.\n- alert is for real problems only (for example auto_renew false). Otherwise null.\n- If has_previous is false, say it is the first day of data and do not talk about changes.\n- Use only the numbers provided. Never invent figures.`;\n\nreturn [{\n  json: {\n    body: {\n      model: 'claude-haiku-5-5',\n      max_tokens: 400,\n      system,\n      messages: [{ role: 'user', content: JSON.stringify(listings) }],\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1232,
        0
      ],
      "id": "c9a2db60-9782-4ff6-8482-62424792eb81",
      "name": "Build prompt"
    },
