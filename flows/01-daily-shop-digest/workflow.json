    {
      "parameters": {
        "jsCode": "const stats = $('Compute deltas').all().map(i => i.json);\n\n// 1) Leer la respuesta de Claude; si falla, usar un resumen de reserva.\nlet ai = null;\ntry {\n  let text = $input.first().json.content[0].text.trim();\n  text = text.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n  const parsed = JSON.parse(text);\n  if (typeof parsed.summary === 'string' && typeof parsed.action === 'string') ai = parsed;\n} catch (e) { /* se usa el plan B */ }\n\nif (!ai) {\n  ai = { summary: 'No pude generar el análisis automático hoy; estas son las cifras.', alert: null, action: 'Revisa las cifras manualmente.' };\n}\n\n// 2) Las cifras las calcula el código, no el modelo.\nconst fmt = d => d === null ? 'n/d' : (d > 0 ? `+${d}` : `${d}`);\nconst lines = stats.map(s =>\n  `• ${s.title}\\n  visitas ${s.views} (${fmt(s.views_delta)}) | favoritos ${s.favorites} (${fmt(s.favorites_delta)})`\n);\n\nconst parts = [`📊 ByJaredStudios · ${$now.toFormat('dd/MM/yyyy')}`, '', ...lines, '', ai.summary];\nif (ai.alert) parts.push('', `⚠️ ${ai.alert}`);\nparts.push('', `👉 ${ai.action}`);\n\nreturn [{ json: { message: parts.join('\\n') } }];"
      },
